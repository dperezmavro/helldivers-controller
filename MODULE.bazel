module(
    name = "helldivers_controller",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_cc", version = "0.2.19")

# ── External repository rules ─────────────────────────────────────────────────

new_local_repository = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:local.bzl",
    "new_local_repository",
)

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

# ── Tool chain (avr-gcc installed by arduino-cli) ─────────────────────────────
# Not hermetic: paths are machine-specific.
# For CI, replace these new_local_repository entries with http_archive rules
# that download the same packages from downloads.arduino.cc / GitHub.

new_local_repository(
    name = "avr_gcc",
    path = "/Users/dionisioperez-mavrogenis/Library/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7",
    build_file = "//toolchain:avr_gcc.BUILD",
)

# ── Arduino libraries (installed by arduino-cli) ─────────────────────────────

new_local_repository(
    name = "arduino_avr_core",
    path = "/Users/dionisioperez-mavrogenis/Library/Arduino15/packages/arduino/hardware/avr/1.8.8",
    build_file = "//toolchain:core.BUILD",
)

http_archive(
    name = "arduino_keyboard",
    url = "https://github.com/arduino-libraries/Keyboard/archive/refs/tags/1.0.6.tar.gz",
    sha256 = "1aa135707550c9ba9eb53660d82029f6327bafcc5cb5f9a82b7db495c88abeeb",
    strip_prefix = "Keyboard-1.0.6",
    build_file = "//toolchain:keyboard.BUILD",
)

http_archive(
    name = "arduino_mouse",
    url = "https://github.com/arduino-libraries/Mouse/archive/refs/tags/1.0.1.tar.gz",
    sha256 = "9269148995b5053a31781a085715f86ba60d9cf209fa1f13ba108858f1f50204",
    strip_prefix = "Mouse-1.0.1",
    build_file = "//toolchain:mouse.BUILD",
)

# SparkFun AVR boards 1.1.13 (install with: arduino-cli core install SparkFun:avr)
new_local_repository(
    name = "sparkfun_avr",
    path = "/Users/dionisioperez-mavrogenis/Library/Arduino15/packages/SparkFun/hardware/avr/1.1.13",
    build_file = "//toolchain:sparkfun_avr.BUILD",
)

http_archive(
    name = "ezbutton",
    url = "https://downloads.arduino.cc/libraries/github.com/ArduinoGetStarted/ezButton-1.0.6.zip",
    sha256 = "9e45e8e46171235b6e30c04b674e523841be19da9012f91166daaccd08e10700",
    strip_prefix = "ezButton-1.0.6",
    build_file = "//toolchain:ezbutton.BUILD",
)

# ── Toolchain registration ────────────────────────────────────────────────────

register_toolchains("//toolchain:avr_toolchain")
