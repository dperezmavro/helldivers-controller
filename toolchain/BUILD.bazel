load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load(":avr_cc_toolchain_config.bzl", "avr_toolchain_config")

_AVR_GCC_BIN = "/Users/dionisioperez-mavrogenis/Library/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/bin"

# ── Platform constraints ──────────────────────────────────────────────────────

constraint_setting(name = "mcu")

constraint_value(
    name = "atmega32u4",
    constraint_setting = ":mcu",
)

platform(
    name = "avr_atmega32u4",
    constraint_values = [":atmega32u4"],
)

# ── CC toolchain ──────────────────────────────────────────────────────────────

avr_toolchain_config(
    name = "avr_cc_toolchain_config",
    avr_gcc_bin_dir = _AVR_GCC_BIN,
)

filegroup(name = "empty", srcs = [])

cc_toolchain(
    name = "avr_cc_toolchain",
    toolchain_config = ":avr_cc_toolchain_config",
    all_files = "@avr_gcc//:all",
    compiler_files = "@avr_gcc//:compiler_files",
    linker_files = "@avr_gcc//:linker_files",
    ar_files = "@avr_gcc//:ar_files",
    as_files = "@avr_gcc//:as_files",
    objcopy_files = "@avr_gcc//:objcopy_files",
    strip_files = "@avr_gcc//:strip_files",
    dwp_files = ":empty",
    supports_param_files = 0,
)

toolchain(
    name = "avr_toolchain",
    exec_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "//toolchain:atmega32u4",
    ],
    toolchain = ":avr_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)
