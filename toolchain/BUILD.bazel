load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load(":avr_cc_toolchain_config.bzl", "avr_toolchain_config")

# ── Platform constraints ──────────────────────────────────────────────────────

constraint_setting(name = "mcu")

constraint_value(
    name = "atmega32u4",
    constraint_setting = ":mcu",
)

platform(
    name = "avr_atmega32u4",
    constraint_values = [":atmega32u4"],
)

# ── CC toolchain ──────────────────────────────────────────────────────────────

avr_toolchain_config(
    name = "avr_cc_toolchain_config",
    avr_gcc = "@avr_gcc//:avr_gcc_binary",
)

filegroup(name = "empty", srcs = [])

# Wrapper scripts that locate the real avr-gcc binaries at runtime.
filegroup(
    name = "wrappers",
    srcs = glob(["wrappers/**"]),
)

# Combined filegroups: avr-gcc binaries + wrapper scripts.
# cc_toolchain attributes accept only a single label, so merging is done here.
filegroup(name = "all_files",      srcs = ["@avr_gcc//:all",            ":wrappers"])
filegroup(name = "compiler_files", srcs = ["@avr_gcc//:compiler_files", ":wrappers"])
filegroup(name = "linker_files",   srcs = ["@avr_gcc//:linker_files",   ":wrappers"])
filegroup(name = "ar_files",       srcs = ["@avr_gcc//:ar_files",       ":wrappers"])
filegroup(name = "as_files",       srcs = ["@avr_gcc//:as_files",       ":wrappers"])
filegroup(name = "objcopy_files",  srcs = ["@avr_gcc//:objcopy_files",  ":wrappers"])
filegroup(name = "strip_files",    srcs = ["@avr_gcc//:strip_files",    ":wrappers"])

cc_toolchain(
    name = "avr_cc_toolchain",
    toolchain_config = ":avr_cc_toolchain_config",
    all_files = ":all_files",
    compiler_files = ":compiler_files",
    linker_files = ":linker_files",
    ar_files = ":ar_files",
    as_files = ":as_files",
    objcopy_files = ":objcopy_files",
    strip_files = ":strip_files",
    dwp_files = ":empty",
    supports_param_files = 0,
)

toolchain(
    name = "avr_toolchain",
    exec_compatible_with = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "//toolchain:atmega32u4",
    ],
    toolchain = ":avr_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)
