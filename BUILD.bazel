load("@rules_cc//cc:defs.bzl", "cc_binary")

# Bazel build targets for the Helldivers stratagem controller.
#
# Native AVR build (preferred):
#   bazel build //:firmware   — compiles sketch + Arduino core with avr-gcc
#   bazel build //:hex        — produces flashable Intel HEX from the ELF
#
# Prerequisites — install once:
#   arduino-cli core install arduino:avr
#   arduino-cli lib install "ezButton"
#
# Legacy arduino-cli build (fallback):
#   bazel build //:compile    — wraps arduino-cli (requires SparkFun:avr core)

_AVR_GCC_BIN = "/Users/dionisioperez-mavrogenis/Library/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/bin"

SKETCH = "helldivers-controller.ino"
BOARD_FQBN = "SparkFun:avr:promicro"

# Homebrew LLVM tools (keg-only, not linked into /usr/local/bin by default).
CLANG_TIDY = "/usr/local/opt/llvm/bin/clang-tidy"
CLANG_FORMAT = "/usr/local/opt/llvm/bin/clang-format"

# ---------------------------------------------------------------------------
# bazel build //:compile
#
# Compiles the sketch to a .hex file ready to flash.
# ---------------------------------------------------------------------------
genrule(
    name = "compile",
    srcs = [SKETCH],
    outs = [SKETCH + ".hex"],
    cmd = """
        arduino-cli compile \\
            --fqbn {fqbn} \\
            --output-dir $(@D) \\
            $(location {sketch})
    """.format(fqbn = BOARD_FQBN, sketch = SKETCH),
    local = True,
    message = "Compiling sketch with arduino-cli",
)

# ---------------------------------------------------------------------------
# bazel build //:generate_compile_commands
#
# Emits compile_commands.json in the workspace root so that clang-tidy and
# IDEs can resolve Arduino/AVR headers.  Run this before :lint for best
# results.  Uses avr-gcc's -MJ flag to capture per-TU compilation databases.
# ---------------------------------------------------------------------------
genrule(
    name = "generate_compile_commands",
    srcs = [SKETCH],
    outs = ["compile_commands.json"],
    cmd = """
        TMP_DIR=$$(mktemp -d)
        arduino-cli compile \\
            --fqbn {fqbn} \\
            --build-property "compiler.cpp.extra_flags=-MJ $$TMP_DIR/cmd.json" \\
            --output-dir $$TMP_DIR \\
            $(location {sketch}) \\
            2>/dev/null || true
        # Wrap single-object fragment in a JSON array
        if [ -f "$$TMP_DIR/cmd.json" ]; then
            echo "[" > $@
            cat "$$TMP_DIR/cmd.json" >> $@
            echo "]" >> $@
        else
            echo "[]" > $@
        fi
    """.format(fqbn = BOARD_FQBN, sketch = SKETCH),
    local = True,
    message = "Generating compile_commands.json",
)

# ---------------------------------------------------------------------------
# bazel build //:lint
#
# Runs clang-tidy on the sketch.  If compile_commands.json exists in the
# workspace root (from :generate_compile_commands), it is used for accurate
# include resolution.  Otherwise a minimal fallback flag set is used.
#
# Lint findings are written to bazel-bin/lint.log and echoed to stdout.
# The target fails only if clang-tidy exits non-zero (i.e. errors found).
# ---------------------------------------------------------------------------
genrule(
    name = "lint",
    srcs = [
        SKETCH,
        ".clang-tidy",
    ] + glob(["stubs/**"], allow_empty = True),
    outs = ["lint.log"],
    cmd = """
        SKETCH=$(location {sketch})
        STUBS=$$(pwd)/stubs
        if [ -f compile_commands.json ]; then
            {clang_tidy} "$$SKETCH" 2>&1 | tee $@
        else
            {clang_tidy} "$$SKETCH" \\
                -- \\
                -x c++ \\
                -std=c++17 \\
                -DARDUINO=10607 \\
                -DARDUINO_AVR_PROMICRO \\
                -DF_CPU=16000000L \\
                -isystem "$$STUBS" \\
                2>&1 | tee $@
        fi
    """.format(sketch = SKETCH, clang_tidy = CLANG_TIDY),
    local = True,
    message = "Running clang-tidy",
)

# ---------------------------------------------------------------------------
# bazel build //:format_check
#
# Verifies that the sketch matches .clang-format style.
# Exits non-zero (and fails the build) if any formatting differs.
# To auto-fix: clang-format -i helldivers-controller.ino
# ---------------------------------------------------------------------------
genrule(
    name = "format_check",
    srcs = [
        SKETCH,
        ".clang-format",
    ],
    outs = ["format_check.log"],
    cmd = """
        SKETCH=$(location {sketch})
        {clang_format} --dry-run --Werror "$$SKETCH" 2>&1 | tee $@
    """.format(sketch = SKETCH, clang_format = CLANG_FORMAT),
    local = True,
    message = "Checking formatting with clang-format",
)

# ---------------------------------------------------------------------------
# bazel build //:firmware
#
# Compiles the sketch and all Arduino dependencies (core, HID, Keyboard, Mouse,
# ezButton) using avr-gcc.  The output is an ELF binary suitable for objcopy.
#
# Bazel's cc rules only compile files with recognised C++ extensions; sketch_cpp
# exists solely to give Bazel a .cpp handle on the .ino source.
# ---------------------------------------------------------------------------
genrule(
    name = "sketch_cpp",
    srcs = [SKETCH],
    outs = ["helldivers_controller.cpp"],
    cmd = "cp $< $@",
)

cc_binary(
    name = "firmware",
    srcs = [":sketch_cpp"],
    deps = [
        "@arduino_keyboard//:keyboard",
        "@arduino_mouse//:mouse",
        "@ezbutton//:ezbutton",
    ],
    linkstatic = True,
)

# ---------------------------------------------------------------------------
# bazel build //:hex
#
# Converts the ELF produced by :firmware into an Intel HEX file ready to flash
# with avrdude:
#   avrdude -c avr109 -p atmega32u4 -P /dev/cu.usbmodem* -U flash:w:bazel-bin/helldivers-controller.hex
# ---------------------------------------------------------------------------
genrule(
    name = "hex",
    srcs = [":firmware"],
    outs = ["helldivers-controller.hex"],
    cmd = "{avr_objcopy} -O ihex -R .eeprom $(location :firmware) $@".format(
        avr_objcopy = _AVR_GCC_BIN + "/avr-objcopy",
    ),
    local = True,
    message = "Converting ELF to Intel HEX",
)
